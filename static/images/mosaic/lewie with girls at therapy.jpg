us:8px; margin-bottom:8px; border:2px solid rgba(0,0,0,0.12);"&gt;` : ''}</=
span>
                    &lt;div style=3D<span class=3D"hljs-string">"display:fl=
ex; justify-content:space-between; align-items:center; font-size:0.73rem; c=
olor:#475569; border-top:1px dashed rgba(15,23,42,0.2); padding-top:6px;"</=
span>&gt;
                        &lt;span&gt;Pinned by &lt;strong&gt;<span class=3D"=
hljs-variable">${escapeChatHtml(n.author_handle)}</span>&lt;/strong&gt;&lt;=
/span&gt;
                        &lt;div style=3D<span class=3D"hljs-string">"displa=
y:flex; gap:8px;"</span>&gt;
                            <span class=3D"hljs-variable">${n.note_type =3D=
=3D=3D 'item' ? `&lt;button type=3D"button" onclick=3D"toggleClaimCorkNote(=
<span class=3D"hljs-variable">${n.id}</span>)" style=3D"background:none; bo=
