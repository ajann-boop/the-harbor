                                    &lt;/div&gt;'</span><span class=3D"hljs=
-string">''</span>

new_title_block =3D <span class=3D"hljs-string">''</span><span class=3D"hlj=
s-string">'&lt;div style=3D"margin-top:8px; display:inline-block; position:=
relative; padding-left:16px;"&gt;
                                        &lt;span style=3D"position:absolute=
; top:-9px; left:2px; font-size:0.54rem; font-weight:900; letter-spacing:0.=
12em; text-transform:uppercase; color:#f59e0b; transform:rotate(-16deg); te=
xt-shadow:0 1px 4px rgba(0,0,0,0.75);"&gt;THE&lt;/span&gt;
                                        &lt;span style=3D"font-size:1.42rem=
; font-weight:900; letter-spacing:0.16em; text-transform:uppercase; backgro=
und:linear-gradient(90deg, #ef4444 0%, #f59e0b 33%, #2dd4bf 68%, #3b82f6 10=
0%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; fil=
ter:drop-shadow(0 2px 6px rgba(0,0,0,0.55));"&gt;HARBOR&lt;/span&gt;
                                    &lt;/div&gt;'</span><span class=3D"hljs=
-string">''</span>

<span class=3D"hljs-keyword">if</span> old_title_block <span class=3D"hljs-=
keyword">in</span> html:
    html =3D html.replace(old_title_block, new_title_block, 1)
    <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">=
"UPDATED CATTY-CORNER 'THE' ABOVE 'HARBOR' &amp; HID VIEW SWITCHER!"</span>=
)
<span class=3D"hljs-keyword">else</span>:
    <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">=
"CHECK TITLE BLOCK"</span>)

open(html_path, <span class=3D"hljs-string">"w"</span>, encoding=3D<span cl=
ass=3D"hljs-string">"utf-8"</span>).write(html)
EOF
