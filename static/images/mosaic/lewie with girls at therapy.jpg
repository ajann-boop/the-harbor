    &lt;script&gt;
        <span class=3D"hljs-keyword">function</span> <span class=3D"hljs-fu=
nction"><span class=3D"hljs-title">openCorkBoard</span></span>() {
            hideAllViews();
            document.getElementById(<span class=3D"hljs-string">'corkboard-=
view'</span>).style.display =3D <span class=3D"hljs-string">'block'</span>;
            loadCorkBoard();
        }
        <span class=3D"hljs-keyword">function</span> <span class=3D"hljs-fu=
nction"><span class=3D"hljs-title">openPinNoteModal</span></span>() {
