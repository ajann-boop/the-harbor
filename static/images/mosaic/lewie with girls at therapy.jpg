            border: none;
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 0.78rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.18s ease;
            background: transparent;
            color: #94a3b8;
        }
        .mode-pill-btn.active {
            background: #14b8a6;
            color: #042f2e;
            box-shadow: 0 2px 8px rgba(20, 184, 166, 0.45);
        }
        body.mode-website .connect-view-section {
            position: relative;
            z-index: 10;
            max-width: 1080px;
            margin: 68px auto 95px !important;
            padding: 20px 18px 90px !important;
        }
        body.mode-overlay .connect-view-section {
