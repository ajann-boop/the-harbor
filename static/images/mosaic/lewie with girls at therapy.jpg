g">'corkFilterZip'</span>).value.trim();
            const res =3D await fetch(`/api/corkboard?<span class=3D"hljs-b=
uilt_in">type</span>=3D<span class=3D"hljs-variable">${encodeURIComponent(t=
ype)}</span>&amp;zip=3D<span class=3D"hljs-variable">${encodeURIComponent(z=
ip)}</span>`);
            const data =3D await res.json();
            const grid =3D document.getElementById(<span class=3D"hljs-stri=
ng">'corkBoardGrid'</span>);
            <span class=3D"hljs-keyword">if</span> (!grid) <span class=3D"h=
ljs-built_in">return</span>;
            const notes =3D data.notes || [];
            <span class=3D"hljs-keyword">if</span> (!notes.length) {
                grid.innerHTML =3D `&lt;div style=3D<span class=3D"hljs-str=
