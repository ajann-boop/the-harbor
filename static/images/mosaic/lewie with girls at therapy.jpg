gba(0, 0, 0, 0.55);
            padding: 22px 16px;
            min-height: 440px;
        }
        .cork-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
            gap: 22px;
            margin-top: 16px;
        }
        .sticky-note-card {
            position: relative;
            padding: 26px 16px 14px;
            border-radius: 4px 4px 14px 4px;
            color: #1e293b;
            box-shadow: 4px 8px 18px rgba(24, 12, 2, 0.45);
            transition: transform 0.18s ease;
        }
        .sticky-note-card:hover {
            transform: scale(1.02) rotate(0deg) !important;
            z-index: 5;
        }
        .cork-pushpin {
            position: absolute;
            top: 8px;
            left: 50%;
            transform: translateX(-50%);
            width: 18px;
            height: 18px;
            border-radius: 50%;
            box-shadow: 0 3px 5px rgba(0,0,0,0.55), inset -3px -3px 5px rgb=
a(0,0,0,0.35), inset 3px 3px 5px rgba(255,255,255,0.65);
        }
