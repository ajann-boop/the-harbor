al'</span>).style.display =3D <span class=3D"hljs-string">'flex'</span>;
            togglePinItemFields();
        }
        <span class=3D"hljs-keyword">function</span> <span class=3D"hljs-fu=
nction"><span class=3D"hljs-title">togglePinItemFields</span></span>() {
            const t =3D document.getElementById(<span class=3D"hljs-string"=
>'pinNoteType'</span>).value;
            document.getElementById(<span class=3D"hljs-string">'pinItemExt=
raFields'</span>).style.display =3D (t =3D=3D=3D <span class=3D"hljs-string=
">'item'</span>) ? <span class=3D"hljs-string">'block'</span> : <span class=
=3D"hljs-string">'none'</span>;
        }
        <span class=3D"hljs-keyword">function</span> resizeImageFile(file) =
{
            <span class=3D"hljs-built_in">return</span> new Promise((resolv=
e) =3D&gt; {
                <span class=3D"hljs-keyword">if</span> (!file) <span class=
=3D"hljs-built_in">return</span> resolve(<span class=3D"hljs-string">''</sp=
an>);
                const reader =3D new FileReader();
                reader.onload =3D (e) =3D&gt; {
                    const img =3D new Image();
                    img.onload =3D () =3D&gt; {
                        const canvas =3D document.createElement(<span class=
=3D"hljs-string">'canvas'</span>);
                        const maxW =3D 640;
                        const scale =3D Math.min(1, maxW / img.width);
                        canvas.width =3D img.width * scale;
                        canvas.height =3D img.height * scale;
                        canvas.getContext(<span class=3D"hljs-string">'2d'<=
/span>).drawImage(img, 0, 0, canvas.width, canvas.height);
                        resolve(canvas.toDataURL(<span class=3D"hljs-string=
">'image/jpeg'</span>, 0.72));
                    };
                    img.src =3D e.target.result;
                };
                reader.readAsDataURL(file);
            });
        }
        async <span class=3D"hljs-keyword">function</span> <span class=3D"h=
ljs-function"><span class=3D"hljs-title">submitCorkNote</span></span>() {
            const note_type =3D document.getElementById(<span class=3D"hljs=
-string">'pinNoteType'</span>).value;
            const title =3D document.getElementById(<span class=3D"hljs-str=
ing">'pinNoteTitle'</span>).value.trim();
            const body =3D document.getElementById(<span class=3D"hljs-stri=
ng">'pinNoteBody'</span>).value.trim();
            const zip_code =3D document.getElementById(<span class=3D"hljs-=
string">'pinNoteZip'</span>).value.trim();
            const free_pledge =3D document.getElementById(<span class=3D"hl=
js-string">'pinFreePledgeCheck'</span>).checked;
            <span class=3D"hljs-keyword">if</span> (!title || !body) { aler=
t(<span class=3D"hljs-string">'Please enter a headline and message.'</span>=
); <span class=3D"hljs-built_in">return</span>; }
            <span class=3D"hljs-keyword">if</span> (!free_pledge) { alert(<=
span class=3D"hljs-string">'Please check the Safe Harbor Zero-Profit Pledge=
 box first.'</span>); <span class=3D"hljs-built_in">return</span>; }

            const fileInput =3D document.getElementById(<span class=3D"hljs=
-string">'pinNotePhoto'</span>);
            const photo_data =3D (note_type =3D=3D=3D <span class=3D"hljs-s=
tring">'item'</span> &amp;&amp; fileInput.files[0]) ? await resizeImageFile=
(fileInput.files[0]) : <span class=3D"hljs-string">''</span>;
            const handle =3D (typeof currentMember !=3D=3D <span class=3D"h=
ljs-string">'undefined'</span> &amp;&amp; currentMember &amp;&amp; currentM=
ember.id) ? currentMember.id : <span class=3D"hljs-string">'CaregiverMember=
'</span>;

            const res =3D await fetch(<span class=3D"hljs-string">'/api/cor=
kboard/pin'</span>, {
                method: <span class=3D"hljs-string">'POST'</span>,
                headers: { <span class=3D"hljs-string">'Content-Type'</span=
>: <span class=3D"hljs-string">'application/json'</span> },
                body: JSON.stringify({ note_type, title, body, zip_code, ph=
oto_data, free_pledge, handle })
            });
            const data =3D await res.json();
            <span class=3D"hljs-keyword">if</span> (!res.ok) { alert(data.e=
rror || <span class=3D"hljs-string">'Could not pin note.'</span>); <span cl=
ass=3D"hljs-built_in">return</span>; }

            document.getElementById(<span class=3D"hljs-string">'pinNoteTit=
le'</span>).value =3D <span class=3D"hljs-string">''</span>;
            document.getElementById(<span class=3D"hljs-string">'pinNoteBod=
y'</span>).value =3D <span class=3D"hljs-string">''</span>;
            document.getElementById(<span class=3D"hljs-string">'pinNoteZip=
'</span>).value =3D <span class=3D"hljs-string">''</span>;
            document.getElementById(<span class=3D"hljs-string">'pinNotePho=
to'</span>).value =3D <span class=3D"hljs-string">''</span>;
            document.getElementById(<span class=3D"hljs-string">'pinFreePle=
dgeCheck'</span>).checked =3D <span class=3D"hljs-literal">false</span>;
            document.getElementById(<span class=3D"hljs-string">'pinNoteMod=
al'</span>).style.display =3D <span class=3D"hljs-string">'none'</span>;
            loadCorkBoard();
        }
        async <span class=3D"hljs-keyword">function</span> <span class=3D"h=
ljs-function"><span class=3D"hljs-title">loadCorkBoard</span></span>() {
            const <span class=3D"hljs-built_in">type</span> =3D document.ge=
tElementById(<span class=3D"hljs-string">'corkFilterType'</span>).value;
