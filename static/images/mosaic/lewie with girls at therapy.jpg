=3D<span class=3D"hljs-string">"utf-8"</span>).<span class=3D"hljs-built_in=
">read</span>()

<span class=3D"hljs-comment"># 1. Point openSharingBoard() straight to open=
CorkBoard() so the bottom "Board" tab &amp; "Sharing Board" card open the C=
ork Board</span>
<span class=3D"hljs-keyword">if</span> <span class=3D"hljs-string">"functio=
n openSharingBoard()"</span> <span class=3D"hljs-keyword">in</span> html:
    import re
    html =3D re.sub(
        r<span class=3D"hljs-string">'function openSharingBoard\(\)\s*\{[^}=
]*\}'</span>,
        <span class=3D"hljs-string">'function openSharingBoard() { openCork=
Board(); }'</span>,
        html,
        count=3D1
    )
    <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">=
"WIRED BOTTOM 'BOARD' TAB &amp; 'SHARING BOARD' CARD TO COMMUNITY CORK BOAR=
D"</span>)

<span class=3D"hljs-comment"># 2. Upgrade Website View vs Overlay View CSS =
so Website View expands the whole app cleanly and Overlay View keeps the sl=
eek app card + modal drawer</span>
old_style_start =3D html.find(<span class=3D"hljs-string">"/* Layout Mode S=
witcher: Website View vs Overlay View */"</span>)
<span class=3D"hljs-keyword">if</span> old_style_start =3D=3D -1:
    old_style_start =3D html.find(<span class=3D"hljs-string">"#layoutModeS=
witcher {"</span>)

<span class=3D"hljs-keyword">if</span> old_style_start !=3D -1:
    style_block_start =3D html.rfind(<span class=3D"hljs-string">"&lt;style=
&gt;"</span>, 0, old_style_start)
    style_block_end =3D html.find(<span class=3D"hljs-string">"&lt;/style&g=
t;"</span>, old_style_start) + len(<span class=3D"hljs-string">"&lt;/style&=
gt;"</span>)
    upgraded_styles =3D <span class=3D"hljs-string">''</span><span class=3D=
"hljs-string">'&lt;style&gt;
        #layoutModeSwitcher {
            position: fixed;
            bottom: 72px;
            right: 16px;
            z-index: 9500;
            display: inline-flex;
            background: rgba(7, 23, 28, 0.92);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(45, 212, 191, 0.45);
            border-radius: 999px;
            padding: 4px;
            gap: 4px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);
        }
        .mode-pill-btn {
            border: none;
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 0.76rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.18s ease;
            background: transparent;
            color: #94a3b8;
        }
        .mode-pill-btn.active {
            background: #14b8a6;
            color: #042f2e;
            box-shadow: 0 2px 8px rgba(20, 184, 166, 0.45);
        }

        /* WEBSITE VIEW: Full wide-screen desktop sanctuary layout */
        body.mode-website .app-container,
        body.mode-website .mobile-shell,
        body.mode-website main,
        body.mode-website .connect-view-section {
            max-width: 1120px !important;
            width: 94% !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }
        body.mode-website .connect-view-section {
            position: relative !important;
            z-index: 10;
            padding-bottom: 95px !important;
        }

        /* OVERLAY VIEW: Centered app card + floating pop-up glass overlay =
for sub-views */
        body.mode-overlay .connect-view-section:not(#member-dashboard-view)=
:not(#guest-entrance-view) {
            position: fixed !important;
            inset: 54px 16px 76px 16px !important;
            max-width: 860px !important;
            margin: 0 auto !important;
            background: rgba(9, 28, 34, 0.97) !important;
            backdrop-filter: blur(16px);
            border: 1px solid rgba(45, 212, 191, 0.42);
            border-radius: 22px;
            box-shadow: 0 24px 65px rgba(0, 0, 0, 0.82), 0 0 0 9999px rgba(=
4, 14, 18, 0.68);
            overflow-y: auto !important;
            z-index: 9000 !important;
            padding: 22px 20px 44px !important;
        }
        #overlayCloseBtn {
            display: none;
            position: sticky;
            top: 0;
            float: right;
            z-index: 9100;
            background: rgba(239, 68, 68, 0.22);
            border: 1px solid rgba(248, 113, 113, 0.5);
            color: #fecaca;
            border-radius: 999px;
            padding: 5px 12px;
            font-size: 0.78rem;
            font-weight: 700;
            cursor: pointer;
        }
        body.mode-overlay #overlayCloseBtn {
            display: inline-block;
        }
    &lt;/style&gt;'</span><span class=3D"hljs-string">''</span>
    html =3D html[:style_block_start] + upgraded_styles + html[style_block_=
end:]
    <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">=
"UPGRADED WEBSITE VIEW &amp; OVERLAY VIEW STYLES"</span>)

open(html_path, <span class=3D"hljs-string">"w"</span>, encoding=3D<span cl=
ass=3D"hljs-string">"utf-8"</span>).write(html)
<span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">"ALL=
 POLISHED &amp; PUSHING!"</span>)
EOF
python3 polish_board_and_views.py &amp;&amp; rm polish_board_and_views.py &=
amp;&amp; git add templates/index.html &amp;&amp; git commit -m <span class=
=3D"hljs-string">"Wire Board tab to Community Cork Board and refine Website=
 View vs Overlay View"</span> &amp;&amp; git push origin main
