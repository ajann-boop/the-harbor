        }
<span class=3D"hljs-string">''</span><span class=3D"hljs-string">'

if "setLayoutViewMode" not in html:
    html =3D html.replace("&lt;/body&gt;", "&lt;script&gt;\n" + view_fix_js=
 + "\n&lt;/script&gt;\n&lt;/body&gt;", 1)

open(html_path, "w", encoding=3D"utf-8").write(html)
