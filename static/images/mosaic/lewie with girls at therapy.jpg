html =3D open(html_path, <span class=3D"hljs-string">"r"</span>, encoding=
=3D<span class=3D"hljs-string">"utf-8"</span>).<span class=3D"hljs-built_in=
">read</span>()

<span class=3D"hljs-comment"># 1. Tighten outer Sanctuary Plaque wrapper so=
 the box hugs right around the red &amp; blue dots</span>
html =3D html.replace(
    <span class=3D"hljs-string">'&lt;div style=3D"margin: 18px auto 12px; m=
ax-width: 315px; text-align: center;"&gt;'</span>,
    <span class=3D"hljs-string">'&lt;div style=3D"margin: 18px auto 12px; m=
ax-width: 268px; text-align: center;"&gt;'</span>,
    1
)

<span class=3D"hljs-comment"># 2. Replace the bottom-left network tag with =
a centered full-width tag flanked by the red &amp; blue dots</span>
old_tag =3D <span class=3D"hljs-string">''</span><span class=3D"hljs-string=
">'&lt;!-- Small Bottom-Left Lewie &amp; Marcus Network Tag --&gt;
                                    &lt;div style=3D"position:absolute; lef=
t:10px; bottom:6px; display:inline-flex; align-items:center; gap:4px; font-=
size:0.54rem; font-weight:700; letter-spacing:0.05em; text-transform:upperc=
ase; color:rgba(203,213,225,0.72);"&gt;
                                        &lt;span style=3D"display:inline-bl=
ock; width:5px; height:5px; border-radius:50%; background:#ef4444;"&gt;&lt;=
/span&gt;
                                        &lt;span&gt;The Lewie &amp;amp; Mar=
cus Network&lt;/span&gt;
                                        &lt;span style=3D"display:inline-bl=
ock; width:5px; height:5px; border-radius:50%; background:#3b82f6;"&gt;&lt;=
/span&gt;
                                    &lt;/div&gt;'</span><span class=3D"hljs=
-string">''</span>

new_tag =3D <span class=3D"hljs-string">''</span><span class=3D"hljs-string=
">'&lt;!-- Centered Full-Width Lewie &amp; Marcus Network Tag --&gt;
                                    &lt;div style=3D"margin-top:10px; width=
:100%; display:flex; align-items:center; justify-content:center; gap:8px; f=
ont-size:0.56rem; font-weight:800; letter-spacing:0.12em; text-transform:up=
percase; color:rgba(226,232,240,0.85);"&gt;
                                        &lt;span style=3D"display:inline-bl=
ock; width:6px; height:6px; border-radius:50%; background:#ef4444; flex-shr=
ink:0;"&gt;&lt;/span&gt;
                                        &lt;span&gt;The Lewie &amp;amp; Mar=
cus Network&lt;/span&gt;
                                        &lt;span style=3D"display:inline-bl=
ock; width:6px; height:6px; border-radius:50%; background:#3b82f6; flex-shr=
ink:0;"&gt;&lt;/span&gt;
                                    &lt;/div&gt;'</span><span class=3D"hljs=
-string">''</span>

<span class=3D"hljs-comment"># Tighten bottom padding on the plaque box now=
 that the tag sits cleanly in flow</span>
html =3D html.replace(<span class=3D"hljs-string">'padding:20px 16px 22px;'=
</span>, <span class=3D"hljs-string">'padding:20px 14px 12px;'</span>, 1)

<span class=3D"hljs-keyword">if</span> old_tag <span class=3D"hljs-keyword"=
>in</span> html:
    html =3D html.replace(old_tag, new_tag, 1)
    <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">=
"CENTERED LEWIE &amp; MARCUS NETWORK &amp; FITTED PLAQUE TO DOTS!"</span>)
<span class=3D"hljs-keyword">else</span>:
    <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">=
"CHECK OLD TAG"</span>)

open(html_path, <span class=3D"hljs-string">"w"</span>, encoding=3D<span cl=
ass=3D"hljs-string">"utf-8"</span>).write(html)
EOF
