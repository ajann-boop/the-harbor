            });
            loadCorkBoard();
        }
        async <span class=3D"hljs-keyword">function</span> flagCorkNote(not=
eId) {
            const reason =3D prompt(<span class=3D"hljs-string">"Why are yo=
u flagging this note? (e.g., Asking for money / selling item)"</span>);
            <span class=3D"hljs-keyword">if</span> (reason =3D=3D=3D null) =
<span class=3D"hljs-built_in">return</span>;
            await fetch(<span class=3D"hljs-string">'/api/corkboard/flag'</=
span>, {
                method: <span class=3D"hljs-string">'POST'</span>,
                headers: { <span class=3D"hljs-string">'Content-Type'</span=
>: <span class=3D"hljs-string">'application/json'</span> },
                body: JSON.stringify({ note_id: noteId, reason })
            });
            alert(<span class=3D"hljs-string">"Thank you for protecting our=
 Safe Harbor. This note has been flagged for Anthony's review."</span>);
            loadCorkBoard();
        }
        async <span class=3D"hljs-keyword">function</span> adminDeleteCorkN=
ote(noteId) {
