ljs-string">'EOF'</span> &gt; fix_login_and_modes.py
import re

html_path =3D <span class=3D"hljs-string">"templates/index.html"</span>
html =3D open(html_path, <span class=3D"hljs-string">"r"</span>, encoding=
=3D<span class=3D"hljs-string">"utf-8"</span>).<span class=3D"hljs-built_in=
">read</span>()

<span class=3D"hljs-comment"># 1. Remove the duplicate Password + Remember =
Me block right before Forgot password?</span>
dup_pattern =3D re.compile(
    r<span class=3D"hljs-string">'&lt;div class=3D"harbor-underline-group"&=
gt;\s*&lt;label for=3D"loginPasswordInput"&gt;Password&lt;/label&gt;.*?&lt;=
span&gt;Remember Me&lt;/span&gt;\s*&lt;/label&gt;'</span>,
    re.DOTALL
)
html, count =3D dup_pattern.subn(<span class=3D"hljs-string">''</span>, htm=
l, count=3D1)
<span class=3D"hljs-built_in">print</span>(f<span class=3D"hljs-string">"RE=
MOVED DUPLICATE PASSWORD/REMEMBER-ME BLOCKS: {count}"</span>)

<span class=3D"hljs-comment"># 2. Give #loginMemberId and #loginPasswordInp=
ut matching solid white boxes (!important) + crisp Show button</span>
login_css_override =3D <span class=3D"hljs-string">''</span><span class=3D"=
hljs-string">'
    &lt;style&gt;
        #loginFormContainer input.harbor-underline-input {
            background: #ffffff !important;
            color: #0f172a !important;
            border: 1px solid rgba(148, 163, 184, 0.55) !important;
            border-radius: 10px !important;
            padding: 10px 14px !important;
            font-size: 0.94rem !important;
            box-shadow: inset 0 1px 3px rgba(15, 23, 42, 0.12) !important;
        }
        #loginFormContainer input#loginPasswordInput {
            padding-right: 68px !important;
        }
        body.mode-website .app-header,
        body.mode-website .dashboard-main,
        body.mode-website .connect-view-section {
            max-width: 1120px !important;
            width: 94% !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }
        body.mode-overlay .app-header,
        body.mode-overlay .dashboard-main {
            max-width: 480px !important;
            margin-left: auto !important;
            margin-right: auto !important;
        }
    &lt;/style&gt;
'</span><span class=3D"hljs-string">''</span>

<span class=3D"hljs-keyword">if</span> <span class=3D"hljs-string">"input#l=
oginPasswordInput"</span> not <span class=3D"hljs-keyword">in</span> html:
    html =3D html.replace(<span class=3D"hljs-string">"&lt;/head&gt;"</span=
>, login_css_override + <span class=3D"hljs-string">"\n&lt;/head&gt;"</span=
>, 1)
    <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">=
"ADDED SOLID WHITE INPUT &amp; DASHBOARD-MAIN WEBSITE/OVERLAY OVERRIDES"</s=
pan>)

open(html_path, <span class=3D"hljs-string">"w"</span>, encoding=3D<span cl=
ass=3D"hljs-string">"utf-8"</span>).write(html)
<span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">"ALL=
 FIXED &amp; PUSHING!"</span>)
EOF
python3 fix_login_and_modes.py &amp;&amp; rm fix_login_and_modes.py &amp;&a=
mp; git add templates/index.html &amp;&amp; git commit -m <span class=3D"hl=
js-string">"Remove duplicate password field, style matching white login box=
es, and bind Website/Overlay view to dashboard-main"</span> &amp;&amp; git =
push origin main
