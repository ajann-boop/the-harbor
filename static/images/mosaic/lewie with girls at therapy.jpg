ainer formatted ng-tns-c707154802-324">cat &lt;&lt; <span class=3D"hljs-str=
ing">'EOF'</span> &gt; fix_auth_and_responsive.py
html_path =3D <span class=3D"hljs-string">"templates/index.html"</span>
html =3D open(html_path, <span class=3D"hljs-string">"r"</span>, encoding=
=3D<span class=3D"hljs-string">"utf-8"</span>).<span class=3D"hljs-built_in=
">read</span>()

<span class=3D"hljs-comment"># 1. Fix Enter key on both login inputs to cal=
l handleLoginClick() directly</span>
html =3D html.replace(
    <span class=3D"hljs-string">"document.querySelector('#loginFormContaine=
r button[type=3Dsubmit], #loginFormContainer .harbor-submit-btn, #memberLog=
inBtn')?.click();"</span>,
    <span class=3D"hljs-string">"if(typeof handleLoginClick=3D=3D=3D'functi=
on'){handleLoginClick();}else{document.querySelector('.harbor-primary-btn')=
?.click();}"</span>
)

<span class=3D"hljs-comment"># 2. Add global togglePwVisibility() + auto-re=
sponsive landscape &amp; resizable overlay CSS</span>
responsive_and_pw_patch =3D <span class=3D"hljs-string">''</span><span clas=
s=3D"hljs-string">'
    &lt;style&gt;
        /* Auto-adapt to Landscape Orientation &amp; Wide Desktop Screens *=
/
        @media (orientation: landscape), (min-width: 768px) {
            body.mode-website .app-header,
            body.mode-website .dashboard-main,
            body.mode-website .connect-view-section {
                max-width: 1180px !important;
                width: 94% !important;
                margin-left: auto !important;
                margin-right: auto !important;
            }
            body.mode-website .harbor-auth-grid,
            body.mode-website .dashboard-grid {
                display: grid !important;
                grid-template-columns: repeat(auto-fit, minmax(340px, 1fr))=
 !important;
                gap: 20px !important;
                align-items: start !important;
            }
        }

        /* Resizable Floating Overlay Window in Overlay View */
        body.mode-overlay .connect-view-section:not(#member-dashboard-view)=
:not(#guest-entrance-view) {
            resize: both !important;
            overflow: auto !important;
            min-width: 320px !important;
            min-height: 360px !important;
            max-width: 95vw !important;
            max-height: 85vh !important;
        }
    &lt;/style&gt;

    &lt;script&gt;
        window.togglePwVisibility =3D function(inputId, btn) {
            const inp =3D document.getElementById(inputId);
            if (!inp) return;
            const isHidden =3D (inp.type =3D=3D=3D '</span>password<span cl=
ass=3D"hljs-string">');
            inp.type =3D isHidden ? '</span>text<span class=3D"hljs-string"=
>' : '</span>password<span class=3D"hljs-string">';
            if (btn) btn.textContent =3D isHidden ? '</span>Hide<span class=
=3D"hljs-string">' : '</span>Show<span class=3D"hljs-string">';
            inp.focus();
        };
    &lt;/script&gt;
'</span><span class=3D"hljs-string">''</span>

<span class=3D"hljs-keyword">if</span> <span class=3D"hljs-string">"window.=
togglePwVisibility"</span> not <span class=3D"hljs-keyword">in</span> html:
    html =3D html.replace(<span class=3D"hljs-string">"&lt;/body&gt;"</span=
>, responsive_and_pw_patch + <span class=3D"hljs-string">"\n&lt;/body&gt;"<=
/span>, 1)
    <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">=
"ADDED WORKING togglePwVisibility() + AUTO-LANDSCAPE &amp; RESIZABLE OVERLA=
Y!"</span>)

open(html_path, <span class=3D"hljs-string">"w"</span>, encoding=3D<span cl=
ass=3D"hljs-string">"utf-8"</span>).write(html)
EOF
python3 fix_auth_and_responsive.py &amp;&amp; rm fix_auth_and_responsive.py=
 &amp;&amp; git add templates/index.html &amp;&amp; git commit -m <span cla=
ss=3D"hljs-string">"Fix Show password toggle, Enter key login submission, a=
nd auto-landscape resizable layout"</span> &amp;&amp; git push origin main
