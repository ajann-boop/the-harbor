from datetime import datetime, timezone, timedelta
from zoneinfo import ZoneInfo

def fmt_est(iso_str):
    if not iso_str:
        return ""
    try:
        dt =3D datetime.fromisoformat(iso_str.replace("Z", "+00:00")).astim=
ezone(ZoneInfo("America/New_York"))
        return dt.strftime("%I:%M %p").lstrip("0")
    except Exception:
        return ""

@app.route("/api/chat/state", methods=3D["GET", "POST"])
def chat_state():
    data =3D request.get_json(silent=3DTrue) or {}
    room =3D (request.args.get("room") or data.get("room") or "Village Chat=
 Room").strip()
    client_id =3D (request.args.get("client_id") or data.get("client_id") o=
r "").strip()
    user =3D session.get("user") or {}
    handle =3D (data.get("handle") or user.get("handle") or (user.get("emai=
l", "").split("@")[0] if user.get("email") else "CaregiverGuest")).strip()
    if not supabase:
        return jsonify({"messages": [], "room_active": 1, "total_active": 1=
})
    try:
        now_utc =3D datetime.now(timezone.utc)
        if client_id:
            supabase.table("chat_presence").upsert({
                "session_token": client_id,
                "room_name": room,
                "member_handle": handle,
                "last_seen": now_utc.isoformat()
            }).execute()
        cutoff =3D (now_utc - timedelta(seconds=3D20)).isoformat()
        supabase.table("chat_presence").delete().lt("last_seen", cutoff).ex=
ecute()

        pres_res =3D supabase.table("chat_presence").select("session_token,=
 room_name").execute()
        pres_rows =3D pres_res.data or []
        total_active =3D max(1, len(pres_rows))
        room_active =3D max(1, sum(1 for r in pres_rows if r.get("room_name=
") =3D=3D room))

        msg_res =3D supabase.table("chat_messages").select("*").eq("room_na=
me", room).order("id", desc=3DTrue).limit(60).execute()
        rows =3D list(reversed(msg_res.data or []))
        for r in rows:
            r["time_str"] =3D fmt_est(r.get("created_at"))
        return jsonify({"messages": rows, "room_active": room_active, "tota=
l_active": total_active})
    except Exception as e:
        return jsonify({"error": str(e), "messages": [], "room_active": 1, =
"total_active": 1})

@app.route("/api/chat/send", methods=3D["POST"])
def chat_send():
    data =3D request.get_json(silent=3DTrue) or {}
    room =3D (data.get("room") or "Village Chat Room").strip()
    text =3D (data.get("message") or "").strip()[:1000]
    if not text:
        return jsonify({"error": "Message cannot be empty"}), 400
    user =3D session.get("user") or {}
    sender_email =3D user.get("email", "")
    sender_handle =3D (data.get("handle") or user.get("handle") or (sender_=
email.split("@")[0] if sender_email else "CaregiverMember")).strip()
    if not supabase:
        return jsonify({"error": "Database not connected"}), 500
    try:
        res =3D supabase.table("chat_messages").insert({
            "room_name": room,
            "sender_handle": sender_handle,
            "sender_email": sender_email,
            "message_text": text
        }).execute()
        msg =3D (res.data or [{}])[0]
        msg["time_str"] =3D fmt_est(msg.get("created_at"))
        return jsonify({"ok": True, "message": msg})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/api/chat/leave", methods=3D["POST"])
def chat_leave():
    data =3D request.get_json(silent=3DTrue) or {}
    client_id =3D (data.get("client_id") or "").strip()
    if supabase and client_id:
        try:
            supabase.table("chat_presence").delete().eq("session_token", cl=
ient_id).execute()
        except Exception:
            pass
    return jsonify({"ok": True})

@app.route("/api/corkboard", methods=3D["GET"])
def get_corkboard():
    filter_type =3D (request.args.get("type") or "all").strip().lower()
    zip_q =3D (request.args.get("zip") or "").strip().lower()
    if not supabase:
        return jsonify({"notes": []})
    try:
        q =3D supabase.table("corkboard_notes").select("*").order("is_claim=
ed", desc=3DFalse).order("id", desc=3DTrue).limit(60)
        if filter_type in ("advice", "item"):
            q =3D q.eq("note_type", filter_type)
        notes =3D q.execute().data or []
        if zip_q:
            notes =3D [n for n in notes if zip_q in (n.get("zip_code") or "=
").lower()]
        note_ids =3D [n["id"] for n in notes]
        replies_map =3D {nid: [] for nid in note_ids}
        if note_ids:
            rep_res =3D supabase.table("corkboard_replies").select("*").in_=
("note_id", note_ids).order("id", desc=3DFalse).execute()
            for r in (rep_res.data or []):
                replies_map.setdefault(r["note_id"], []).append(r)
        for n in notes:
            n["tilt_deg"] =3D float(n.get("tilt_deg") or 0.0)
            n["replies"] =3D replies_map.get(n["id"], [])
        return jsonify({"notes": notes})
    except Exception as e:
        return jsonify({"error": str(e), "notes": []})

@app.route("/api/corkboard/pin", methods=3D["POST"])
def pin_corkboard_note():
    import random
    data =3D request.get_json(silent=3DTrue) or {}
    note_type =3D (data.get("note_type") or "advice").strip().lower()
    title =3D (data.get("title") or "").strip()[:120]
    body =3D (data.get("body") or "").strip()[:1200]
    zip_code =3D (data.get("zip_code") or "").strip()[:25]
    photo_data =3D (data.get("photo_data") or "").strip()
    free_pledge =3D bool(data.get("free_pledge"))
    if not title or not body:
        return jsonify({"error": "Please include a headline and note messag=
e."}), 400
    if note_type =3D=3D "item" and not free_pledge:
        return jsonify({"error": "You must check the 100% Free Gift/Loan Pl=
edge before pinning an item."}), 400
    if len(photo_data) &gt; 650000:
        return jsonify({"error": "Photo is too large. Please pick a smaller=
 image."}), 400
    user =3D session.get("user") or {}
    email =3D user.get("email", "")
    handle =3D (data.get("handle") or user.get("handle") or (email.split("@=
")[0] if email else "CaregiverMember")).strip()
    pin_color =3D random.choice(["#ef4444", "#3b82f6", "#22c55e", "#f59e0b"=
, "#ec4899", "#a855f7", "#06b6d4"])
    note_color =3D random.choice(["#fef08a", "#bae6fd", "#fecdd3", "#bbf7d0=
", "#fed7aa", "#e9d5ff"])
    tilt_deg =3D round(random.uniform(-2.2, 2.2), 1)
    try:
        supabase.table("corkboard_notes").insert({
            "note_type": note_type, "author_handle": handle, "author_email"=
: email,
            "title": title, "body": body, "zip_code": zip_code, "photo_data=
": photo_data,
            "pin_color": pin_color, "note_color": note_color, "tilt_deg": t=
ilt_deg
        }).execute()
        return jsonify({"ok": True})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/api/corkboard/reply", methods=3D["POST"])
def reply_corkboard_note():
    data =3D request.get_json(silent=3DTrue) or {}
    note_id =3D data.get("note_id")
    reply_text =3D (data.get("reply_text") or "").strip()[:600]
    if not note_id or not reply_text:
        return jsonify({"error": "Reply cannot be empty"}), 400
    user =3D session.get("user") or {}
    email =3D user.get("email", "")
    handle =3D (data.get("handle") or user.get("handle") or (email.split("@=
")[0] if email else "CaregiverMember")).strip()
    try:
        supabase.table("corkboard_replies").insert({"note_id": note_id, "au=
thor_handle": handle, "reply_text": reply_text}).execute()
        return jsonify({"ok": True})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/api/corkboard/flag", methods=3D["POST"])
def flag_corkboard_note():
    data =3D request.get_json(silent=3DTrue) or {}
    note_id =3D data.get("note_id")
    reason =3D (data.get("reason") or "Suspected selling / marketplace viol=
ation").strip()[:250]
    try:
        supabase.table("corkboard_notes").update({"is_flagged": True, "flag=
_reason": reason}).eq("id", note_id).execute()
        return jsonify({"ok": True})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/api/corkboard/claim", methods=3D["POST"])
def claim_corkboard_note():
    data =3D request.get_json(silent=3DTrue) or {}
    note_id =3D data.get("note_id")
    try:
        cur_row =3D supabase.table("corkboard_notes").select("is_claimed").=
eq("id", note_id).execute().data
        new_val =3D not bool(cur_row[0]["is_claimed"]) if cur_row else True
        supabase.table("corkboard_notes").update({"is_claimed": new_val}).e=
q("id", note_id).execute()
        return jsonify({"ok": True})
    except Exception as e:
        return jsonify({"error": str(e)}), 500

@app.route("/api/corkboard/admin-delete", methods=3D["POST"])
def admin_delete_corkboard_note():
    data =3D request.get_json(silent=3DTrue) or {}
    pin =3D (data.get("pin") or "").strip()
    note_id =3D data.get("note_id")
    if pin !=3D os.environ.get("ADMIN_PIN", "4321"):
        return jsonify({"error": "Invalid Admin PIN"}), 403
    try:
        supabase.table("corkboard_notes").delete().eq("id", note_id).execut=
e()
        return jsonify({"ok": True})
    except Exception as e:
        return jsonify({"error": str(e)}), 500
