.sfc-layout-container { display: flex; flex-direction: row; height: 100%; w=
idth: 100%; }

.sfc-sidebar { width: 288px; flex-shrink: 0; height: 100%; display: flex; f=
lex-direction: column; }

.sfc-main-content { flex: 1 1 0%; height: 100%; position: relative; display=
: flex; flex-direction: column; }

nav.chat-app-skip-link-nav > xap-skip-link { z-index: 1001; }

nav.chat-app-skip-link-nav > xap-skip-link:focus-within { top: 0px; left: 0=
px; }

sentinel { }
