                    btn.id =3D <span class=3D"hljs-string">'overlayCloseBtn=
'</span>;
                    btn.type =3D <span class=3D"hljs-string">'button'</span=
>;
                    btn.innerHTML =3D <span class=3D"hljs-string">'=E2=9C=
=95 Close Overlay'</span>;
                    btn.onclick =3D closeOverlayView;
                    sec.insertBefore(btn, sec.firstChild);
                }
            });
        });

