view_fix_js =3D <span class=3D"hljs-string">''</span><span class=3D"hljs-st=
ring">'
        function setLayoutViewMode(mode) {
            const m =3D (mode =3D=3D=3D '</span>overlay<span class=3D"hljs-=
string">') ? '</span>overlay<span class=3D"hljs-string">' : '</span>website=
<span class=3D"hljs-string">';
            document.body.classList.remove('</span>mode-website<span class=
=3D"hljs-string">', '</span>mode-overlay<span class=3D"hljs-string">');
            document.body.classList.add('</span>mode-<span class=3D"hljs-st=
ring">' + m);
            localStorage.setItem('</span>syw_layout_mode<span class=3D"hljs=
-string">', m);
            const wb =3D document.getElementById('</span>btnWebsiteView<spa=
n class=3D"hljs-string">');
            const ob =3D document.getElementById('</span>btnOverlayView<spa=
n class=3D"hljs-string">');
            if (wb) wb.classList.toggle('</span>active<span class=3D"hljs-s=
tring">', m =3D=3D=3D '</span>website<span class=3D"hljs-string">');
