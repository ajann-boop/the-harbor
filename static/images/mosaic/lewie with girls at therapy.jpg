        async <span class=3D"hljs-keyword">function</span> submitCorkReply(=
noteId) {
            const inp =3D document.getElementById(<span class=3D"hljs-strin=
g">'corkReplyInput_'</span> + noteId);
            const reply_text =3D (inp.value || <span class=3D"hljs-string">=
''</span>).trim();
            <span class=3D"hljs-keyword">if</span> (!reply_text) <span clas=
s=3D"hljs-built_in">return</span>;
            const handle =3D (typeof currentMember !=3D=3D <span class=3D"h=
ljs-string">'undefined'</span> &amp;&amp; currentMember &amp;&amp; currentM=
ember.id) ? currentMember.id : <span class=3D"hljs-string">'CaregiverMember=
'</span>;
            await fetch(<span class=3D"hljs-string">'/api/corkboard/reply'<=
/span>, {
                method: <span class=3D"hljs-string">'POST'</span>,
                headers: { <span class=3D"hljs-string">'Content-Type'</span=
>: <span class=3D"hljs-string">'application/json'</span> },
                body: JSON.stringify({ note_id: noteId, reply_text, handle =
})
            });
            loadCorkBoard();
        }
        async <span class=3D"hljs-keyword">function</span> toggleClaimCorkN=
ote(noteId) {
            await fetch(<span class=3D"hljs-string">'/api/corkboard/claim'<=
/span>, {
                method: <span class=3D"hljs-string">'POST'</span>,
                headers: { <span class=3D"hljs-string">'Content-Type'</span=
>: <span class=3D"hljs-string">'application/json'</span> },
