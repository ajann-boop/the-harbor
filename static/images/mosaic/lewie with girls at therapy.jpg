=3D"code-container formatted ng-tns-c707154802-262">cat &lt;&lt; <span clas=
s=3D"hljs-string">'EOF'</span> &gt; frosted_login_update.py
import re

html_path =3D <span class=3D"hljs-string">"templates/index.html"</span>
html =3D open(html_path, <span class=3D"hljs-string">"r"</span>, encoding=
=3D<span class=3D"hljs-string">"utf-8"</span>).<span class=3D"hljs-built_in=
">read</span>()

<span class=3D"hljs-comment"># 1. Frosted-glass styling on .harbor-glass-ca=
rd so background photos shine through</span>
frosted_css =3D <span class=3D"hljs-string">""</span><span class=3D"hljs-st=
ring">"
&lt;style&gt;
.harbor-glass-card {
    background: rgba(7, 26, 32, 0.42) !important;
    backdrop-filter: blur(14px) saturate(140%) !important;
    -webkit-backdrop-filter: blur(14px) saturate(140%) !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 25=
5, 255, 0.15) !important;
}
#loginFormContainer {
    padding-bottom: 18px !important;
}
&lt;/style&gt;
"</span><span class=3D"hljs-string">""</span>
<span class=3D"hljs-keyword">if</span> <span class=3D"hljs-string">"backdro=
p-filter: blur(14px)"</span> not <span class=3D"hljs-keyword">in</span> htm=
l:
    html =3D html.replace(<span class=3D"hljs-string">"&lt;/head&gt;"</span=
>, frosted_css + <span class=3D"hljs-string">"\n&lt;/head&gt;"</span>, 1)

<span class=3D"hljs-comment"># 2. Put "Forgot password?" and "Not a member?=
 Click here" on the same horizontal row</span>
forgot_pattern =3D re.compile(
    r<span class=3D"hljs-string">'&lt;button type=3D"button" onclick=3D"han=
dleForgotPassword\(\)"[^&gt;]*&gt;Forgot password\?&lt;/button&gt;'</span>,
    re.DOTALL
)
combined_links_row =3D <span class=3D"hljs-string">''</span><span class=3D"=
hljs-string">'&lt;div style=3D"display:flex; align-items:center; justify-co=
ntent:space-between; gap:10px; flex-wrap:wrap; margin:4px 0 6px;"&gt;
                                &lt;button type=3D"button" onclick=3D"handl=
eForgotPassword()" style=3D"background:none; border:none; color:#99f6e4; fo=
nt-size:0.81rem; font-weight:600; text-decoration:underline; cursor:pointer=
; padding:0;"&gt;Forgot password?&lt;/button&gt;
                                &lt;span style=3D"font-size:0.81rem; color:=
#e2e8f0;"&gt;Not a member? &lt;button type=3D"button" onclick=3D"switchAuth=
Tab('</span>signup<span class=3D"hljs-string">')" style=3D"background:none;=
 border:none; color:#5eead4; font-weight:700; text-decoration:underline; cu=
rsor:pointer; padding:0; font-size:0.81rem;"&gt;Click here&lt;/button&gt;&l=
t;/span&gt;
                            &lt;/div&gt;'</span><span class=3D"hljs-string"=
>''</span>

html, c1 =3D forgot_pattern.subn(combined_links_row, html, count=3D1)

<span class=3D"hljs-comment"># 3. Remove the old standalone "Not a member? =
Click here" block below the Sanctuary Plaque</span>
old_signup_block =3D re.compile(
    r<span class=3D"hljs-string">'&lt;div style=3D"text-align:center; margi=
n-top:16px; font-size:0\.88rem; color:#e2e8f0;\s*"&gt;\s*Not a member\?\s*&=
lt;button type=3D"button" onclick=3D"switchAuthTab\(\'</span>signup\<span c=
lass=3D"hljs-string">'\)"[^&gt;]*&gt;\s*Click here\s*&lt;/button&gt;\s*&lt;=
/div&gt;'</span>,
    re.DOTALL
)
html, c2 =3D old_signup_block.subn(<span class=3D"hljs-string">''</span>, h=
tml, count=3D1)

<span class=3D"hljs-built_in">print</span>(f<span class=3D"hljs-string">"FR=
OSTED GLASS APPLIED | LINKS MERGED: {c1} | OLD BLOCK REMOVED: {c2}"</span>)
open(html_path, <span class=3D"hljs-string">"w"</span>, encoding=3D<span cl=
ass=3D"hljs-string">"utf-8"</span>).write(html)
EOF
python3 frosted_login_update.py &amp;&amp; rm frosted_login_update.py &amp;=
&amp; git add templates/index.html &amp;&amp; git commit -m <span class=3D"=
hljs-string">"Apply frosted-glass login card backdrop and pair Not a member=
 link with Forgot password"</span> &amp;&amp; git push origin main
