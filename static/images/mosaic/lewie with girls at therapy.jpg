=3D<span class=3D"hljs-string">"utf-8"</span>).<span class=3D"hljs-built_in=
">read</span>()

<span class=3D"hljs-comment"># 1. Add Website View vs Overlay View CSS + fl=
oating toggle bar</span>
view_mode_css_and_bar =3D <span class=3D"hljs-string">''</span><span class=
=3D"hljs-string">'
    &lt;style&gt;
        /* Layout Mode Switcher: Website View vs Overlay View */
        #layoutModeSwitcher {
            position: fixed;
            top: 14px;
            right: 16px;
            z-index: 9500;
            display: inline-flex;
            background: rgba(7, 23, 28, 0.88);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(45, 212, 191, 0.35);
            border-radius: 999px;
            padding: 4px;
            gap: 4px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
        }
        .mode-pill-btn {
            border: none;
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 0.78rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.18s ease;
            background: transparent;
            color: #94a3b8;
        }
        .mode-pill-btn.active {
            background: #14b8a6;
            color: #042f2e;
            box-shadow: 0 2px 8px rgba(20, 184, 166, 0.45);
        }

        /* Clean full-page spacing in Website View */
        body.mode-website .connect-view-section {
            position: relative;
            z-index: 10;
            max-width: 1080px;
            margin: 68px auto 95px !important;
            padding: 20px 18px 90px !important;
        }

        /* Floating glass card drawer in Overlay View */
        body.mode-overlay .connect-view-section {
            position: fixed !important;
            inset: 58px 16px 76px 16px !important;
            max-width: 980px !important;
            margin: 0 auto !important;
            background: rgba(9, 28, 34, 0.96) !important;
            backdrop-filter: blur(14px);
            border: 1px solid rgba(45, 212, 191, 0.38);
            border-radius: 22px;
            box-shadow: 0 24px 65px rgba(0, 0, 0, 0.78), 0 0 0 9999px rgba(=
4, 14, 18, 0.65);
            overflow-y: auto !important;
            z-index: 9000 !important;
            padding: 22px 20px 40px !important;
        }
        #overlayCloseBtn {
            display: none;
            position: sticky;
            top: 0;
            float: right;
            z-index: 9100;
            background: rgba(239, 68, 68, 0.2);
            border: 1px solid rgba(248, 113, 113, 0.45);
            color: #fecaca;
            border-radius: 999px;
            padding: 5px 12px;
            font-size: 0.78rem;
            font-weight: 700;
            cursor: pointer;
        }
        body.mode-overlay #overlayCloseBtn {
            display: inline-block;
        }
    &lt;/style&gt;

    &lt;div id=3D"layoutModeSwitcher" title=3D"Switch between Full Website =
View and Floating Overlay View"&gt;
        &lt;button type=3D"button" id=3D"btnWebsiteView" class=3D"mode-pill=
-btn active" onclick=3D"setLayoutViewMode('</span>website<span class=3D"hlj=
s-string">')"&gt;=F0=9F=8C=90 Website View&lt;/button&gt;
        &lt;button type=3D"button" id=3D"btnOverlayView" class=3D"mode-pill=
-btn" onclick=3D"setLayoutViewMode('</span>overlay<span class=3D"hljs-strin=
g">')"&gt;=F0=9F=AA=9F Overlay View&lt;/button&gt;
    &lt;/div&gt;
'</span><span class=3D"hljs-string">''</span>

<span class=3D"hljs-keyword">if</span> <span class=3D"hljs-string">"layoutM=
odeSwitcher"</span> not <span class=3D"hljs-keyword">in</span> html:
    html =3D html.replace(<span class=3D"hljs-string">"&lt;body&gt;"</span>=
, <span class=3D"hljs-string">"&lt;body class=3D\"mode-website\"&gt;\n"</sp=
an> + view_mode_css_and_bar, 1)
    <span class=3D"hljs-keyword">if</span> <span class=3D"hljs-string">"&lt=
;body class=3D\"mode-website\"&gt;"</span> not <span class=3D"hljs-keyword"=
>in</span> html:
        html =3D html.replace(<span class=3D"hljs-string">"&lt;body "</span=
>, <span class=3D"hljs-string">"&lt;body class=3D\"mode-website\" "</span>,=
 1)
        html =3D html.replace(<span class=3D"hljs-string">"&lt;/body&gt;"</=
span>, view_mode_css_and_bar + <span class=3D"hljs-string">"\n&lt;/body&gt;=
"</span>, 1)
    <span class=3D"hljs-built_in">print</span>(<span class=3D"hljs-string">=
"ADDED WEBSITE VIEW / OVERLAY VIEW SWITCHER"</span>)

<span class=3D"hljs-comment"># 2. Bulletproof hideAllViews() so NO two view=
s ever overlap + add setLayoutViewMode()</span>
view_fix_js =3D <span class=3D"hljs-string">''</span><span class=3D"hljs-st=
ring">'
        function setLayoutViewMode(mode) {
            const m =3D (mode =3D=3D=3D '</span>overlay<span class=3D"hljs-=
string">') ? '</span>overlay<span class=3D"hljs-string">' : '</span>website=
<span class=3D"hljs-string">';
            document.body.classList.remove('</span>mode-website<span class=
=3D"hljs-string">', '</span>mode-overlay<span class=3D"hljs-string">');
            document.body.classList.add('</span>mode-<span class=3D"hljs-st=
ring">' + m);
            localStorage.setItem('</span>syw_layout_mode<span class=3D"hljs=
-string">', m);
            const wb =3D document.getElementById('</span>btnWebsiteView<spa=
n class=3D"hljs-string">');
            const ob =3D document.getElementById('</span>btnOverlayView<spa=
n class=3D"hljs-string">');
            if (wb) wb.classList.toggle('</span>active<span class=3D"hljs-s=
tring">', m =3D=3D=3D '</span>website<span class=3D"hljs-string">');
            if (ob) ob.classList.toggle('</span>active<span class=3D"hljs-s=
tring">', m =3D=3D=3D '</span>overlay<span class=3D"hljs-string">');
        }

        function closeOverlayView() {
            document.querySelectorAll('</span>.connect-view-section<span cl=
ass=3D"hljs-string">').forEach(el =3D&gt; {
                el.style.display =3D '</span>none<span class=3D"hljs-string=
">';
            });
            const dash =3D document.getElementById('</span>member-dashboard=
-view<span class=3D"hljs-string">');
            if (dash) dash.style.display =3D '</span>block<span class=3D"hl=
js-string">';
        }

        window.addEventListener('</span>DOMContentLoaded<span class=3D"hljs=
-string">', () =3D&gt; {
            const savedMode =3D localStorage.getItem('</span>syw_layout_mod=
e<span class=3D"hljs-string">') || '</span>website<span class=3D"hljs-strin=
g">';
            setLayoutViewMode(savedMode);
            document.querySelectorAll('</span>.connect-view-section<span cl=
ass=3D"hljs-string">').forEach(sec =3D&gt; {
                if (sec.id !=3D=3D '</span>member-dashboard-view<span class=
=3D"hljs-string">' &amp;&amp; sec.id !=3D=3D '</span>guest-entrance-view<sp=
an class=3D"hljs-string">' &amp;&amp; !sec.querySelector('</span><span clas=
s=3D"hljs-comment">#overlayCloseBtn')) {</span>
                    const btn =3D document.createElement(<span class=3D"hlj=
s-string">'button'</span>);
                    btn.id =3D <span class=3D"hljs-string">'overlayCloseBtn=
'</span>;
                    btn.type =3D <span class=3D"hljs-string">'button'</span=
>;
                    btn.innerHTML =3D <span class=3D"hljs-string">'=E2=9C=
=95 Close Overlay'</span>;
                    btn.onclick =3D closeOverlayView;
                    sec.insertBefore(btn, sec.firstChild);
                }
            });
        });

        // Wrap hideAllViews so every .connect-view-section (including cork=
board-view) is guaranteed hidden
        <span class=3D"hljs-keyword">if</span> (typeof hideAllViews =3D=3D=
=3D <span class=3D"hljs-string">'function'</span>) {
            const _origHideAllViews =3D hideAllViews;
            hideAllViews =3D <span class=3D"hljs-function"><span class=3D"h=
ljs-title">function</span></span>() {
                _origHideAllViews();
                document.querySelectorAll(<span class=3D"hljs-string">'.con=
nect-view-section'</span>).forEach(el =3D&gt; {
                    el.style.display =3D <span class=3D"hljs-string">'none'=
</span>;
                });
            };
        }
<span class=3D"hljs-string">''</span><span class=3D"hljs-string">'

if "setLayoutViewMode" not in html:
    html =3D html.replace("&lt;/body&gt;", "&lt;script&gt;\n" + view_fix_js=
 + "\n&lt;/script&gt;\n&lt;/body&gt;", 1)
    print("PATCHED hideAllViews() &amp; ADDED OVERLAY DRAWER LOGIC")

open(html_path, "w", encoding=3D"utf-8").write(html)
print("VIEW OVERLAP FIXED + WEBSITE/OVERLAY TOGGLE PUSHING!")
EOF
