cork_backend =3D <span class=3D"hljs-string">''</span><span class=3D"hljs-s=
tring">'
# --- COMMUNITY CORK BOARD (ADVICE &amp; ZERO-PROFIT GIFT/LOAN BOARD) ---
def init_corkboard_tables():
    conn =3D get_db_conn()
    if not conn:
        return
    try:
        with conn.cursor() as cur:
            cur.execute("""
                CREATE TABLE IF NOT EXISTS corkboard_notes (
                    id SERIAL PRIMARY KEY,
                    note_type TEXT NOT NULL DEFAULT '</span>advice<span cla=
ss=3D"hljs-string">',
                    author_handle TEXT NOT NULL,
                    author_email TEXT,
                    title TEXT NOT NULL,
                    body TEXT NOT NULL,
                    zip_code TEXT DEFAULT '</span><span class=3D"hljs-strin=
g">',
                    photo_data TEXT DEFAULT '</span><span class=3D"hljs-str=
ing">',
                    pin_color TEXT DEFAULT '</span><span class=3D"hljs-comm=
ent">#ef4444',</span>
                    note_color TEXT DEFAULT <span class=3D"hljs-string">'#f=
ef08a'</span>,
                    tilt_deg NUMERIC(4,1) DEFAULT 0.0,
                    is_claimed BOOLEAN DEFAULT FALSE,
                    is_flagged BOOLEAN DEFAULT FALSE,
                    flag_reason TEXT DEFAULT <span class=3D"hljs-string">''=
</span>,
                    created_at TIMESTAMPTZ DEFAULT NOW()
                );
            <span class=3D"hljs-string">""</span><span class=3D"hljs-string=
">")
            cur.execute("</span><span class=3D"hljs-string">""</span>
                CREATE TABLE IF NOT EXISTS corkboard_replies (
                    id SERIAL PRIMARY KEY,
                    note_id INTEGER REFERENCES corkboard_notes(id) ON DELET=
E CASCADE,
                    author_handle TEXT NOT NULL,
                    reply_text TEXT NOT NULL,
                    created_at TIMESTAMPTZ DEFAULT NOW()
                );
            <span class=3D"hljs-string">""</span><span class=3D"hljs-string=
">")
        conn.commit()
    except Exception as e:
        print("</span>Corkboard DB init error:<span class=3D"hljs-string">"=
, e)
    finally:
        conn.close()

init_corkboard_tables()

@app.route("</span>/api/corkboard<span class=3D"hljs-string">", methods=3D[=
"</span>GET<span class=3D"hljs-string">"])
def get_corkboard():
    filter_type =3D (request.args.get("</span><span class=3D"hljs-built_in"=
>type</span><span class=3D"hljs-string">") or "</span>all<span class=3D"hlj=
s-string">").strip().lower()
    zip_q =3D (request.args.get("</span>zip<span class=3D"hljs-string">") o=
r "</span><span class=3D"hljs-string">").strip()
    conn =3D get_db_conn()
    if not conn:
        return jsonify({"</span>notes<span class=3D"hljs-string">": []})
    try:
        with conn.cursor(cursor_factory=3DRealDictCursor) as cur:
            query =3D "</span><span class=3D"hljs-string">""</span>
                SELECT id, note_type, author_handle, title, body, zip_code,=
 photo_data,
                       pin_color, note_color, tilt_deg, is_claimed, is_flag=
ged, flag_reason,
                       TO_CHAR(created_at AT TIME ZONE <span class=3D"hljs-=
string">'America/New_York'</span>, <span class=3D"hljs-string">'Mon DD, HH1=
2:MI AM'</span>) AS time_str
                FROM corkboard_notes
                WHERE 1=3D1
            <span class=3D"hljs-string">""</span><span class=3D"hljs-string=
">"
            params =3D []
            if filter_type in ("</span>advice<span class=3D"hljs-string">",=
 "</span>item<span class=3D"hljs-string">"):
                query +=3D "</span> AND note_type =3D %s<span class=3D"hljs=
-string">"
                params.append(filter_type)
            if zip_q:
                query +=3D "</span> AND zip_code ILIKE %s<span class=3D"hlj=
s-string">"
                params.append(f"</span>%{zip_q}%<span class=3D"hljs-string"=
>")
            query +=3D "</span> ORDER BY is_claimed ASC, id DESC LIMIT 60;<=
span class=3D"hljs-string">"
            cur.execute(query, params)
            notes =3D cur.fetchall()

            note_ids =3D [n["</span>id<span class=3D"hljs-string">"] for n =
in notes]
            replies_map =3D {nid: [] for nid in note_ids}
            if note_ids:
                cur.execute("</span><span class=3D"hljs-string">""</span>
                    SELECT id, note_id, author_handle, reply_text,
                           TO_CHAR(created_at AT TIME ZONE <span class=3D"h=
ljs-string">'America/New_York'</span>, <span class=3D"hljs-string">'Mon DD,=
 HH12:MI AM'</span>) AS time_str
                    FROM corkboard_replies
                    WHERE note_id =3D ANY(%s)
                    ORDER BY id ASC;
                <span class=3D"hljs-string">""</span><span class=3D"hljs-st=
ring">", (note_ids,))
                for r in cur.fetchall():
                    replies_map[r["</span>note_id<span class=3D"hljs-string=
">"]].append(r)

            for n in notes:
                n["</span>tilt_deg<span class=3D"hljs-string">"] =3D float(=
n["</span>tilt_deg<span class=3D"hljs-string">"] or 0.0)
                n["</span>replies<span class=3D"hljs-string">"] =3D replies=
_map.get(n["</span>id<span class=3D"hljs-string">"], [])
        return jsonify({"</span>notes<span class=3D"hljs-string">": notes})
    except Exception as e:
        return jsonify({"</span>error<span class=3D"hljs-string">": str(e),=
 "</span>notes<span class=3D"hljs-string">": []}), 500
    finally:
        conn.close()

@app.route("</span>/api/corkboard/pin<span class=3D"hljs-string">", methods=
=3D["</span>POST<span class=3D"hljs-string">"])
def pin_corkboard_note():
    import random
    data =3D request.get_json(silent=3DTrue) or {}
    note_type =3D (data.get("</span>note_type<span class=3D"hljs-string">")=
 or "</span>advice<span class=3D"hljs-string">").strip().lower()
    title =3D (data.get("</span>title<span class=3D"hljs-string">") or "</s=
pan><span class=3D"hljs-string">").strip()[:120]
    body =3D (data.get("</span>body<span class=3D"hljs-string">") or "</spa=
n><span class=3D"hljs-string">").strip()[:1200]
    zip_code =3D (data.get("</span>zip_code<span class=3D"hljs-string">") o=
r "</span><span class=3D"hljs-string">").strip()[:25]
    photo_data =3D (data.get("</span>photo_data<span class=3D"hljs-string">=
") or "</span><span class=3D"hljs-string">").strip()
    free_pledge =3D bool(data.get("</span>free_pledge<span class=3D"hljs-st=
ring">"))

    if not title or not body:
        return jsonify({"</span>error<span class=3D"hljs-string">": "</span=
>Please include a headline and note message.<span class=3D"hljs-string">"})=
, 400
    if note_type =3D=3D "</span>item<span class=3D"hljs-string">" and not f=
ree_pledge:
        return jsonify({"</span>error<span class=3D"hljs-string">": "</span=
>You must check the 100% Free Gift/Loan Pledge before pinning an item.<span=
 class=3D"hljs-string">"}), 400
    if len(photo_data) &gt; 650000:
        return jsonify({"</span>error<span class=3D"hljs-string">": "</span=
>Photo is too large. Please pick a smaller image.<span class=3D"hljs-string=
">"}), 400

    user =3D session.get("</span>user<span class=3D"hljs-string">") or {}
    email =3D user.get("</span>email<span class=3D"hljs-string">", "</span>=
<span class=3D"hljs-string">")
    handle =3D (data.get("</span>handle<span class=3D"hljs-string">") or us=
er.get("</span>handle<span class=3D"hljs-string">") or (email.split("</span=
>@<span class=3D"hljs-string">")[0] if email else "</span>CaregiverMember<s=
pan class=3D"hljs-string">")).strip()

    pin_colors =3D ["</span><span class=3D"hljs-comment">#ef4444", "#3b82f6=
", "#22c55e", "#f59e0b", "#ec4899", "#a855f7", "#06b6d4"]</span>
    note_colors =3D [<span class=3D"hljs-string">"#fef08a"</span>, <span cl=
ass=3D"hljs-string">"#bae6fd"</span>, <span class=3D"hljs-string">"#fecdd3"=
</span>, <span class=3D"hljs-string">"#bbf7d0"</span>, <span class=3D"hljs-=
string">"#fed7aa"</span>, <span class=3D"hljs-string">"#e9d5ff"</span>]
    pin_color =3D random.choice(pin_colors)
    note_color =3D random.choice(note_colors)
    tilt_deg =3D round(random.uniform(-2.2, 2.2), 1)

    conn =3D get_db_conn()
    <span class=3D"hljs-keyword">if</span> not conn:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: <span class=3D"hljs-string">"Database not con=
nected"</span>}), 500
    try:
        with conn.cursor() as cur:
            cur.execute(<span class=3D"hljs-string">""</span><span class=3D=
"hljs-string">"
                INSERT INTO corkboard_notes
                (note_type, author_handle, author_email, title, body, zip_c=
ode, photo_data, pin_color, note_color, tilt_deg)
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s);
            "</span><span class=3D"hljs-string">""</span>, (note_type, hand=
le, email, title, body, zip_code, photo_data, pin_color, note_color, tilt_d=
eg))
        conn.commit()
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"ok"</span>: True})
    except Exception as e:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: str(e)}), 500
    finally:
        conn.close()

@app.route(<span class=3D"hljs-string">"/api/corkboard/reply"</span>, metho=
ds=3D[<span class=3D"hljs-string">"POST"</span>])
def reply_corkboard_note():
    data =3D request.get_json(silent=3DTrue) or {}
    note_id =3D data.get(<span class=3D"hljs-string">"note_id"</span>)
    reply_text =3D (data.get(<span class=3D"hljs-string">"reply_text"</span=
>) or <span class=3D"hljs-string">""</span>).strip()[:600]
    <span class=3D"hljs-keyword">if</span> not note_id or not reply_text:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: <span class=3D"hljs-string">"Reply cannot be =
empty"</span>}), 400
    user =3D session.get(<span class=3D"hljs-string">"user"</span>) or {}
    email =3D user.get(<span class=3D"hljs-string">"email"</span>, <span cl=
ass=3D"hljs-string">""</span>)
    handle =3D (data.get(<span class=3D"hljs-string">"handle"</span>) or us=
er.get(<span class=3D"hljs-string">"handle"</span>) or (email.split(<span c=
lass=3D"hljs-string">"@"</span>)[0] <span class=3D"hljs-keyword">if</span> =
email <span class=3D"hljs-keyword">else</span> <span class=3D"hljs-string">=
"CaregiverMember"</span>)).strip()
    conn =3D get_db_conn()
    <span class=3D"hljs-keyword">if</span> not conn:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: <span class=3D"hljs-string">"Database not con=
nected"</span>}), 500
    try:
        with conn.cursor() as cur:
            cur.execute(<span class=3D"hljs-string">"INSERT INTO corkboard_=
replies (note_id, author_handle, reply_text) VALUES (%s, %s, %s);"</span>, =
(note_id, handle, reply_text))
        conn.commit()
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"ok"</span>: True})
    except Exception as e:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: str(e)}), 500
    finally:
        conn.close()

@app.route(<span class=3D"hljs-string">"/api/corkboard/flag"</span>, method=
s=3D[<span class=3D"hljs-string">"POST"</span>])
def flag_corkboard_note():
    data =3D request.get_json(silent=3DTrue) or {}
    note_id =3D data.get(<span class=3D"hljs-string">"note_id"</span>)
    reason =3D (data.get(<span class=3D"hljs-string">"reason"</span>) or <s=
pan class=3D"hljs-string">"Suspected selling / marketplace violation"</span=
>).strip()[:250]
    conn =3D get_db_conn()
    <span class=3D"hljs-keyword">if</span> not conn or not note_id:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: <span class=3D"hljs-string">"Invalid request"=
</span>}), 400
    try:
        with conn.cursor() as cur:
            cur.execute(<span class=3D"hljs-string">"UPDATE corkboard_notes=
 SET is_flagged =3D TRUE, flag_reason =3D %s WHERE id =3D %s;"</span>, (rea=
son, note_id))
        conn.commit()
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"ok"</span>: True})
    except Exception as e:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: str(e)}), 500
    finally:
        conn.close()

@app.route(<span class=3D"hljs-string">"/api/corkboard/claim"</span>, metho=
ds=3D[<span class=3D"hljs-string">"POST"</span>])
def claim_corkboard_note():
    data =3D request.get_json(silent=3DTrue) or {}
    note_id =3D data.get(<span class=3D"hljs-string">"note_id"</span>)
    conn =3D get_db_conn()
    <span class=3D"hljs-keyword">if</span> not conn or not note_id:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: <span class=3D"hljs-string">"Invalid request"=
</span>}), 400
    try:
        with conn.cursor() as cur:
            cur.execute(<span class=3D"hljs-string">"UPDATE corkboard_notes=
 SET is_claimed =3D NOT is_claimed WHERE id =3D %s;"</span>, (note_id,))
        conn.commit()
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"ok"</span>: True})
    except Exception as e:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: str(e)}), 500
    finally:
        conn.close()

@app.route(<span class=3D"hljs-string">"/api/corkboard/admin-delete"</span>=
, methods=3D[<span class=3D"hljs-string">"POST"</span>])
def admin_delete_corkboard_note():
    data =3D request.get_json(silent=3DTrue) or {}
    pin =3D (data.get(<span class=3D"hljs-string">"pin"</span>) or <span cl=
ass=3D"hljs-string">""</span>).strip()
    note_id =3D data.get(<span class=3D"hljs-string">"note_id"</span>)
    <span class=3D"hljs-keyword">if</span> pin !=3D os.environ.get(<span cl=
ass=3D"hljs-string">"ADMIN_PIN"</span>, <span class=3D"hljs-string">"4321"<=
/span>):
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: <span class=3D"hljs-string">"Invalid Admin PI=
N"</span>}), 403
    conn =3D get_db_conn()
    <span class=3D"hljs-keyword">if</span> not conn or not note_id:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: <span class=3D"hljs-string">"Invalid request"=
</span>}), 400
    try:
        with conn.cursor() as cur:
            cur.execute(<span class=3D"hljs-string">"DELETE FROM corkboard_=
notes WHERE id =3D %s;"</span>, (note_id,))
        conn.commit()
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"ok"</span>: True})
    except Exception as e:
        <span class=3D"hljs-built_in">return</span> jsonify({<span class=3D=
"hljs-string">"error"</span>: str(e)}), 500
    finally:
        conn.close()
