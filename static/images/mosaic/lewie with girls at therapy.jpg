                <span class=3D"hljs-built_in">return</span>;
            }
            grid.innerHTML =3D notes.map(n =3D&gt; {
                const repliesHtml =3D (n.replies || []).map(r =3D&gt; `
                    &lt;div style=3D<span class=3D"hljs-string">"background=
:rgba(255,255,255,0.55); padding:6px 8px; border-radius:6px; margin-top:6px=
; font-size:0.78rem;"</span>&gt;
                        &lt;strong&gt;<span class=3D"hljs-variable">${escap=
eChatHtml(r.author_handle)}</span>:&lt;/strong&gt; <span class=3D"hljs-vari=
able">${escapeChatHtml(r.reply_text)}</span>
                    &lt;/div&gt;
                `).join(<span class=3D"hljs-string">''</span>);
                <span class=3D"hljs-built_in">return</span> `
                &lt;div class=3D<span class=3D"hljs-string">"sticky-note-ca=
rd"</span> style=3D<span class=3D"hljs-string">"background:<span class=3D"h=
ljs-variable">${escapeChatHtml(n.note_color)}</span>; transform:rotate(<spa=
n class=3D"hljs-variable">${n.tilt_deg}</span>deg); <span class=3D"hljs-var=
iable">${n.is_claimed ? 'opacity:0.72;' : ''}</span>"</span>&gt;
                    &lt;div class=3D<span class=3D"hljs-string">"cork-pushp=
in"</span> style=3D<span class=3D"hljs-string">"background:<span class=3D"h=
ljs-variable">${escapeChatHtml(n.pin_color)}</span>;"</span>&gt;&lt;/div&gt=
;
                    &lt;div style=3D<span class=3D"hljs-string">"display:fl=
ex; justify-content:space-between; align-items:center; gap:6px; font-size:0=
.72rem; font-weight:700; color:#475569; margin-bottom:6px;"</span>&gt;
                        &lt;span&gt;<span class=3D"hljs-variable">${n.note_=
type =3D=3D=3D 'item' ? '=F0=9F=8E=81 FREE GIFT / LOAN' : '=F0=9F=92=AC ADV=
ICE &amp; TIPS'}</span>&lt;/span&gt;
                        <span class=3D"hljs-variable">${n.zip_code ? `&lt;s=
pan style=3D"background:rgba(15,23,42,0.12); padding:2px 7px; border-radius=
:999px;"&gt;=F0=9F=93=8D <span class=3D"hljs-variable">${escapeChatHtml(n.z=
ip_code)}</span>&lt;/span&gt;` : ''}</span>
                    &lt;/div&gt;
                    <span class=3D"hljs-variable">${n.is_claimed ? `&lt;div=
 style=3D"background:#16a34a; color:#fff; font-size:0.72rem; font-weight:80=
0; padding:3px 8px; border-radius:6px; display:inline-block; margin-bottom:=
6px;"&gt;=E2=9C=93 CLAIMED / GIFTED&lt;/div&gt;` : ''}</span>
                    &lt;h4 style=3D<span class=3D"hljs-string">"margin:0 0 =
6px; font-size:1rem; color:#0f172a;"</span>&gt;<span class=3D"hljs-variable=
">${escapeChatHtml(n.title)}</span>&lt;/h4&gt;
                    &lt;p style=3D<span class=3D"hljs-string">"margin:0 0 8=
px; font-size:0.86rem; line-height:1.4; color:#1e293b; white-space:pre-wrap=
;"</span>&gt;<span class=3D"hljs-variable">${escapeChatHtml(n.body)}</span>=
&lt;/p&gt;
                    <span class=3D"hljs-variable">${n.photo_data ? `&lt;img=
 src=3D"<span class=3D"hljs-variable">${n.photo_data}</span>" alt=3D"Pinned=
