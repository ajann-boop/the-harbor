------MultipartBoundary--iIlq6nUP7uKEyxEreUniubMA1uSaAKjH22WhVsjspu----
Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: chrome://file-manager/foreground/elements/files_quick_view.css

@charset "utf-8";

dialog { background-color: transparent; border-width: medium; border-style:=
 none; border-color: currentcolor; border-image: none; font-size: 100%; hei=
ght: 100%; margin: 0px; max-height: initial; max-width: initial; opacity: 0=
; outline: none; overflow: hidden; padding: 0px; width: 100%; }

dialog[open] { opacity: 1; transition: opacity 200ms; }

dialog:focus { outline: none; }

dialog#delete-confirm-dialog::backdrop { background-color: transparent; }

.thumbnail { flex: 0 0 auto; height: 100%; width: 100%; }

#video-poster { max-height: 100%; max-width: 100%; }

#audio-artwork { height: 100%; margin: 0px auto; width: 100%; }

#mainPanel { background-color: transparent; bottom: 0px; margin: 0px; paddi=
ng: 0px; position: absolute; top: 56px; width: 100%; }

#contentPanel { background-color: transparent; display: flex; height: 100%;=
 justify-content: center; position: relative; }

#contentPanel[metadata-box-active] { margin-inline-end: 320px; }

:host-context(html[dir=3D"rtl"]) #contentPanel[metadata-box-active] { margi=
n-inline: auto 320px; }

#innerContentPanel { background-color: var(--cros-sys-scrim); color: var(--=
cros-sys-on_surface); display: flex; flex-direction: column; font: var(--cr=
os-body-1-font); height: calc(100% - 64px); justify-content: center; outlin=
e: none; padding: 32px; position: relative; text-align: center; width: 100%=
; }

#innerContentPanel[type=3D"audio"], #innerContentPanel[type=3D"image"], #in=
nerContentPanel[type=3D"video"] { align-self: center; }

.content { height: 100%; width: 100%; }

#toolbar { align-items: center; background-color: var(--cros-sys-app_base);=
 color: var(--cros-sys-on_surface); display: flex; font: var(--cros-title-1=
-font); height: 56px; margin: 0px; opacity: 1; padding: 0px; z-index: 1; }

#file-path { flex: 1 1 0%; margin-inline: 8px; max-width: 100%; overflow: h=
idden; text-overflow: ellipsis; }

.buttons-group { display: flex; }

cr-button { --hover-bg-color: var(--cros-sys-hover_on_subtle); --ink-color:=
 var(--cros-sys-ripple_neutral_on_subtle); --ripple-opacity: 100%; --text-c=
olor: currentColor; border-width: medium; border-style: none; border-color:=
 currentcolor; border-image: none; border-radius: 12px; box-shadow: none; b=
ox-sizing: border-box; height: 40px; margin: 4px; min-width: 40px; padding:=
 0px; width: 40px; }

:host-context(html.pointer-active) cr-button:not(:active):hover { --hover-b=
g-color: none; cursor: unset; }

cr-button::after { content: ""; height: 48px; position: absolute; width: 48=
px; }

#back-button > .icon, #open-button > .icon, #delete-button > .icon, #info-b=
utton > .icon { mask-position: center center; mask-repeat: no-repeat; backg=
round-color: currentcolor; background-image: none; height: 36px; width: 36p=
x; }

iron-icon { height: 16px; width: 16px; }

#back-button > iron-icon { display: none; }

#back-button > .icon { mask-image: url("../images/files/ui/back.svg"); }

#open-button > .icon { mask-image: url("../images/files/ui/external_link.sv=
g"); }

#delete-button > .icon { mask-image: url("../images/files/ui/delete_ng.svg"=
); height: 16px; width: 16px; }

#info-button { --ink-color: var(--cros-sys-ripple_primary); }

#info-button[aria-pressed=3D"true"] { background-color: var(--cros-sys-prim=
ary_container); color: var(--cros-sys-on_primary_container); }

#info-button > .icon { mask-image: url("../images/files/ui/info.svg"); }

:host-context(html.focus-outline-visible) cr-button:not(:active):focus { ou=
tline: 2px solid var(--cros-sys-focus_ring); }

#metadata-box { background-color: var(--cros-sys-app_base); bottom: 0px; he=
ight: 100%; margin: 0px; opacity: 1; overflow-y: auto; position: absolute; =
right: 0px; }

:host-context(html[dir=3D"rtl"]) #metadata-box { left: 0px; right: auto; }

::-webkit-scrollbar { background-color: var(--cros-sys-scrollbar); width: 1=
0px; }

