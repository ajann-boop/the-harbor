@charset "utf-8";

[file-type-icon] { mask-image: url("../images/filetype/filetype_generic.svg=
"); mask-position: center center; mask-repeat: no-repeat; background-color:=
 currentcolor; }

[file-type-icon=3D"archive"] { mask-image: url("../images/filetype/filetype=
_archive.svg"); }

[file-type-icon=3D"audio"] { mask-image: url("../images/filetype/filetype_a=
udio.svg"); }

[file-type-icon=3D"excel"] { mask-image: url("../images/filetype/filetype_e=
xcel.svg"); }

