Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: chrome://file-manager/foreground/css/common.css

@charset "utf-8";

[hidden] { display: none !important; }

cr-button { --active-bg: none; box-shadow: none; }

cr-menu.chrome-menu { background-color: var(--cros-sys-base_elevated); bord=
er-radius: 8px; box-shadow: var(--cros-elevation-2-shadow); color: var(--cr=
os-sys-on_surface); font: var(--cros-button-2-font); min-width: 208px; outl=
ine: none; overflow: hidden; padding: 8px 0px; transition: opacity 200ms ea=
se-in; z-index: 600; }

cr-menu#gear-menu, cr-menu#file-context-menu { min-width: 256px; }

cr-menu.chrome-menu[hidden] { opacity: 0; pointer-events: none; visibility:=
 hidden; display: block !important; }

cr-menu.chrome-menu.hide-delayed[hidden] { transition-delay: 120ms; transit=
ion-property: opacity, visibility; }

cr-menu.chrome-menu > :not(hr) { height: 36px; outline: none; }

cr-menu.chrome-menu > cr-menu-item[disabled] { color: var(--cros-sys-disabl=
ed); pointer-events: none; }

cr-menu.chrome-menu > cr-menu-item#volume-space-info[disabled] { color: inh=
erit; pointer-events: none; }

cr-menu.chrome-menu > cr-menu-item[disabled] > .icon.start { opacity: 0.2; =
}

cr-menu.chrome-menu > hr { background: var(--cros-sys-separator); height: 1=
px; margin: 8px 0px; }

cr-menu.chrome-menu > hr:first-child { display: none; }

cr-menu.chrome-menu > cr-menu-item[checked]::after { mask-image: url("../im=
ages/common/ic_selected.svg"); mask-position: center center; mask-repeat: n=
o-repeat; background-color: var(--cros-sys-primary); content: ""; float: ri=
ght; height: 20px; margin-inline-end: calc(-4px); width: 20px; }

html[dir=3D"rtl"] cr-menu.chrome-menu > cr-menu-item[checked]::after { floa=
t: left; }

cr-menu.chrome-menu > cr-menu-item#volume-space-info { height: auto; min-he=
ight: 36px; }

cr-menu#file-context-menu.toolbar-menu > .hide-on-toolbar { display: none; =
}

button { background-color: var(--cros-sys-primary_container); border-width:=
 medium; border-style: none; border-color: currentcolor; border-image: none=
; border-radius: 18px; box-sizing: border-box; color: var(--cros-sys-on_pri=
mary_container); cursor: pointer; font: var(--cros-button-2-font); height: =
36px; margin: 0px; min-height: 36px; min-width: 5.14em; outline: none; padd=
ing: 8px 16px; position: relative; text-align: center; user-select: none; z=
-index: 0; }

button > .hover-layer { border-radius: 18px; content: ""; display: none; in=
set: 0px; pointer-events: none; position: absolute; z-index: 1; }

button > paper-ripple { --paper-ripple-opacity: 1; border-radius: 18px; col=
or: var(--cros-sys-ripple_primary); }

button:hover > .hover-layer { display: block; }

button.cr-dialog-ok, button.primary { background-color: var(--cros-sys-prim=
ary); color: var(--cros-sys-on_primary); }

button.cr-dialog-ok:hover > .hover-layer, button.primary:hover > .hover-lay=
er { background-color: var(--cros-sys-hover_on_prominent); }

button.cr-dialog-cancel:hover > .hover-layer, button.secondary:hover > .hov=
er-layer { background-color: var(--cros-sys-hover_on_subtle); }

button[disabled] { background-color: var(--cros-sys-disabled_container); co=
lor: var(--cros-sys-disabled); cursor: default; pointer-events: none; }

button[disabled]:hover > .hover-layer { display: none; }

:root.focus-outline-visible button:not(:active):focus, :host-context(:root.=
focus-outline-visible) button:not(:active):focus { outline: 2px solid var(-=
-cros-sys-focus_ring); outline-offset: 2px; }

.cr-dialog-container .cr-dialog-buttons > button.cr-dialog-ok { margin-inli=
ne-start: 8px; order: 1; }

.cr-dialog-container .cr-dialog-buttons > button.cr-dialog-cancel { order: =
0; }

.cr-dialog-container .cr-dialog-frame.files-confirm-dialog-cancel-default .=
cr-dialog-buttons > button:not(:active):focus { outline: 2px solid var(--cr=
os-sys-focus_ring); outline-offset: 2px; }

.buttonbar button:not(:first-child) { margin-inline-start: 8px; }

.progress-bar { background-color: var(--cros-sys-highlight_shape); border-r=
adius: 3px; height: 6px; margin-bottom: 6px; margin-top: 8px; }

.progress-track { background-color: var(--cros-sys-primary); border-radius:=
 3px; height: 6px; min-width: 6px; }

.menu-warning { color: var(--cros-sys-error); font: var(--cros-annotation-2=
-font); }

html[dir=3D"rtl"] .entry-name { direction: ltr; text-align: right; unicode-=
bidi: embed; }

.cr-dialog-container.shown { background-color: var(--cros-sys-scrim); }

.cr-dialog-container { display: flex; height: 100%; left: 0px; overflow: au=
to; position: absolute; top: 0px; user-select: none; width: 100%; z-index: =
9999; }

.cr-dialog-container .cr-dialog-frame { background-color: var(--cros-sys-di=
alog_container); border-radius: 20px; box-shadow: var(--cros-elevation-3-sh=
adow); color: var(--cros-sys-on_surface_variant); cursor: default; display:=
 flex; flex-direction: column; margin: auto; max-width: min(448px, 75vw); m=
in-width: calc(256px); padding: 32px 32px 28px; position: relative; }

.cr-dialog-container .cr-dialog-frame:focus { outline: none; }

@keyframes pulse {=20
  0% { transform: scale(1); }
  40% { transform: scale(1.02); }
  60% { transform: scale(1.02); }
  100% { transform: scale(1); }
}

.cr-dialog-container.pulse { animation-duration: 180ms; animation-iteration=
-count: 1; animation-name: pulse; animation-timing-function: ease-in-out; }

.cr-dialog-container.shown > .cr-dialog-frame { opacity: 1; }

.cr-dialog-container .cr-dialog-frame { opacity: 0; transition: opacity 100=
ms; }

.cr-dialog-container .cr-dialog-title { color: var(--cros-sys-on_surface); =
display: block; font: var(--cros-display-7-font); margin-bottom: 16px; }

.cr-dialog-container .cr-dialog-text { font: var(--cros-body-1-font); }

.cr-dialog-container .cr-dialog-text, .cr-dialog-container .cr-dialog-title=
 { overflow-wrap: break-word; }

.cr-dialog-container .cr-dialog-text { color: var(--cros-sys-on_surface_var=
iant); }

.cr-dialog-container .cr-dialog-buttons { display: flex; flex-direction: ro=
w; justify-content: flex-end; padding-top: 32px; }

.cr-dialog-container .cr-dialog-close { --hover-bg-color: var(--cros-sys-ho=
ver_on_subtle); --ink-color: var(--cros-sys-ripple_neutral_on_subtle); --ri=
pple-opacity: 100%; border-width: medium; border-style: none; border-color:=
 currentcolor; border-image: none; border-radius: 16px; color: var(--cros-s=
ys-on_surface); display: none; height: 32px; min-width: 32px; padding: 0px;=
 position: absolute; right: 16px; top: 16px; width: 32px; }

html.focus-outline-visible .cr-dialog-container .cr-dialog-close:not(:activ=
e):focus { outline: 2px solid var(--cros-sys-focus_ring); }

.cr-dialog-container #default-task-dialog .cr-dialog-close { display: inlin=
e-block; }

.cr-dialog-container .cr-dialog-close > .icon { mask-image: url("../images/=
common/ic_close.svg"); mask-position: center center; mask-repeat: no-repeat=
; mask-size: 16px auto; background-color: currentcolor; height: 32px; posit=
ion: absolute; width: 32px; }

:root[dir=3D"rtl"] .cr-dialog-container .cr-dialog-close, :host-context(:ro=
ot[dir=3D"rtl"]) .cr-dialog-container .cr-dialog-close { left: 16px; right:=
 unset !important; }

#files-app-modal-dialog { background-color: transparent; border-width: medi=
um; border-style: none; border-color: currentcolor; border-image: none; hei=
ght: 100%; margin: 0px; max-height: initial; max-width: initial; outline: n=
one; overflow: hidden; padding: 0px; width: 100%; }

.tree-row > .label, .table-row-cell .filename-label, .table-row-cell .size,=
 .table-row-cell .type, .table-row-cell .date, .thumbnail-bottom .filename-=
label, .autocomplete-suggestions > li > .detail-text { padding-top: 1px; }

@media (-webkit-min-device-pixel-ratio: 1.5) {
  .tree-row > .label, .table-row-cell .filename-label, .table-row-cell .siz=
e, .table-row-cell .type, .table-row-cell .date, .thumbnail-bottom .filenam=
e-label, .autocomplete-suggestions > li > .detail-text { padding-top: 3px; =
}
}

.button2 { color: var(--cros-sys-on_surface); font: var(--cros-button-2-fon=
t); }

.body2-primary { color: var(--cros-sys-on_surface); font: var(--cros-body-2=
-font); }
