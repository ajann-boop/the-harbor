.no-preview { max-width: 130px; }

.no-preview-container { mask-image: url("../images/files/ui/quickview_star.=
svg"); mask-position: center center; mask-repeat: no-repeat; mask-size: 224=
px auto; align-items: center; background-color: var(--cros-sys-primary_cont=
ainer); color: var(--cros-sys-on_primary_container); display: flex; flex-di=
rection: column; height: 224px; justify-content: center; }

